#!/usr/bin/env bash
# Toggle the tiling layout of the active workspace between dwindle and monocle.
# User-owned replacement for Omarchy's dwindle <-> scrolling toggle
# (omarchy-hyprland-workspace-layout-toggle).
#
# The choice is persisted into the state directory that Omarchy's
# /usr/share/omarchy/default/hypr/workspace-layouts.lua loads on every config
# reload, so quoting matters twice:
#   * in the persisted .lua file
#   * in the `hyprctl eval` statement
# An unquoted bare word (layout = monocle) is an undefined Lua global -> nil,
# which silently drops the rule while hyprctl still reports "ok".

set -uo pipefail

ALT_LAYOUT="${1:-monocle}"
LAYOUTS_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/workspace-layouts"

ws_json="$(hyprctl -j activeworkspace)" || exit 1
ws="$(jq -r '.name // .id // empty' <<<"$ws_json")"
current="$(jq -r '.tiledLayout // empty' <<<"$ws_json")"

[[ -n "$ws" && -n "$current" ]] || exit 1

if [[ "$current" == "$ALT_LAYOUT" ]]; then
  new=dwindle
else
  new="$ALT_LAYOUT"
fi

# Persist (quoted values only), with a filesystem-safe file name.
slug="${ws//[^a-zA-Z0-9._-]/_}"
mkdir -p "$LAYOUTS_DIR"
printf 'hl.workspace_rule({ workspace = "%s", layout = "%s" })\n' "$ws" "$new" >"$LAYOUTS_DIR/$slug.lua"

hyprctl eval "hl.workspace_rule({ workspace = \"$ws\", layout = \"$new\" })" >/dev/null 2>&1

# Verify it actually applied before reporting success.
applied="$(hyprctl -j activeworkspace | jq -r '.tiledLayout // empty')"
if [[ "$applied" == "$new" ]]; then
  omarchy-notification-send -g "󱂬" "Layout: $new"
else
  omarchy-notification-send -g "󱂬" "Layout change failed ($current -> $new)"
  exit 1
fi
